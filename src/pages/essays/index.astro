---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { allQuestions, allTopics, essayTitle, B } from '../../lib/data';
const marksSet: number[] = B.essayMarks;
const isEssay = (q) => q.format === 'Essay' || (q.format === 'Synoptic' && q.marks >= 9);
const essays = allQuestions.filter((q) => isEssay(q) && !q.notCurrentSpec).sort((a, b) => b.year - a.year);
const title = (q) => essayTitle(q.text).slice(0, 260);
const byTopic = allTopics.map((t) => [t, essays.filter((q) => q.topics[0] === t.slug)]).filter(([, qs]) => qs.length);
const count = (m) => essays.filter((q) => q.marks === m).length;
const marksList = [...new Set(essays.map((q) => q.marks))].sort((a, b) => b - a);
const minPerMark = B.id === 'aqa' ? 1.25 : 1.3;
---
<Base title={`Every ${B.full} essay question since ${B.since}, by topic, with a timed essay tool`} description={`All ${marksSet.join(', ')}-mark essay questions set on ${B.short} AS and A-level Geography since ${B.since}, grouped by topic, with the series each was set and a timed-essay tool that reveals the mark scheme and its levels.`} context="essays" leadLine="Want your essays marked against the levels? Message us.">
  <h1>Every essay title, and a timed practice tool</h1>
  <p>{essays.length} essay questions from {B.short} Geography papers since {B.since}: {marksList.map((m, i) => <>{i ? ', ' : ''}{count(m)} worth {m} marks</>)}. Grouped by topic with the series each appeared in. Pick one to write under timed conditions (about {minPerMark} minutes a mark, the exam's pace), then open the mark scheme with its levels and indicative content and award yourself a level.</p>
  <p class="muted">{B.levelsNote}</p>
  <h2>Timed essay</h2>
  <div class="panel">
    <div class="chips" id="topic-chips">{byTopic.map(([t]) => <button class="chip" type="button" data-topic={t.slug} aria-pressed="false">{t.name}</button>)}</div>
    <div class="chips" data-group="marks"><button class="chip" type="button" data-v="" aria-pressed="true">Any</button>{marksList.map((m) => <button class="chip" type="button" data-v={String(m)}>{m}-mark</button>)}</div>
    <div><button class="btn btn-accent" type="button" id="draw">Give me a title</button> <span class="muted">(random from the selected topics, or from all)</span></div>
  </div>
  <div id="play" hidden>
    <div class="playbar"><span id="which"></span><span class="timer" id="timer">20:00</span><button class="btn" type="button" id="starttimer"><Icon name="timer" />Start the clock</button></div>
    <div id="card"></div>
    <p class="muted">Open the mark scheme under the question and tap the level your answer reaches to save a score.</p>
  </div>
  <h2>All titles by topic</h2>
  {byTopic.map(([t, qs]) => <><h3><a href={`/questions/${t.slug}/`}>{t.name}</a> <span class="muted">({qs.length})</span></h3>
    <div class="table-wrap"><table><thead><tr><th>Series</th><th>Paper</th><th>Marks</th><th>Title</th></tr></thead>
    <tbody>{qs.map((q) => <tr><td>{q.series}</td><td>{q.level === 'AS' ? 'AS ' : ''}{q.paper} Q{q.question}</td><td>{q.marks}</td><td><a href={`/questions/${t.slug}/#${q.id}`}>{title(q)}</a></td></tr>)}</tbody></table></div></>)}
  <script define:vars={{ minPerMark }}>window.__minPerMark = minPerMark;</script>
  <script>
    import { loadBank, card, saveScore, shuffle, fmtTime } from '../../scripts/player.js';
    const $ = (s) => document.querySelector(s);
    const sel = new Set(); let marks = '', bank = null, timer = null, secs = 1200, current = null;
    const isEssay = (q) => q.lv && (q.f === 'Essay' || (q.f === 'Synoptic' && q.m >= 9));
    document.querySelectorAll('[data-topic]').forEach((b) => b.addEventListener('click', () => { const on = b.getAttribute('aria-pressed') !== 'true'; b.setAttribute('aria-pressed', String(on)); on ? sel.add(b.dataset.topic) : sel.delete(b.dataset.topic); }));
    document.querySelectorAll('[data-group="marks"] .chip').forEach((b) => b.addEventListener('click', () => { document.querySelectorAll('[data-group="marks"] .chip').forEach((x) => x.setAttribute('aria-pressed', 'false')); b.setAttribute('aria-pressed', 'true'); marks = b.dataset.v; }));
    loadBank().then((b) => { bank = b; });
    $('#draw').addEventListener('click', () => {
      if (!bank) return;
      const pool = bank.q.filter((q) => isEssay(q) && !q.old && q.c && (!marks || q.m === Number(marks)) && (!sel.size || q.t.some((t) => sel.has(t))));
      if (!pool.length) return;
      current = shuffle(pool)[0];
      secs = Math.round(current.m * 60 * (window.__minPerMark || 1.25));
      $('#play').hidden = false; $('#which').textContent = `${current.s} ${current.l === 'AS' ? 'AS ' : ''}${current.p} Q${current.q} (${current.m} marks)`; $('#timer').textContent = fmtTime(secs); if (timer) clearInterval(timer);
      const holder = $('#card'); holder.innerHTML = ''; holder.appendChild(card(current, { mark: true, onMark: (m) => saveScore(current.t, m, current.m, current.id) }));
      window.scrollTo({ top: $('#play').offsetTop - 80, behavior: 'smooth' });
    });
    $('#starttimer').addEventListener('click', () => { if (timer) clearInterval(timer); timer = setInterval(() => { secs--; $('#timer').textContent = fmtTime(Math.max(secs, 0)); if (secs <= 0) { clearInterval(timer); $('#timer').textContent = "Time's up"; } }, 1000); });
  </script>
</Base>
